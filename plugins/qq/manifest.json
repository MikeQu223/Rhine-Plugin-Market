    "license": "MIT",
    "attribution": "THIRD-PARTY-NOTICES.md",
    "sbom": "sbom.cdx.json",
    "runtime": {
        "hosting": [
            "module"
        ],
        "mobileBundled": true,
        "sourceEntry": "index.mjs",
        "bundled": true,
        "diagnosticsOrdinal": 2,
        "env": {
            "RHINE_QQ_DEVICE_STATE_PATH": "$dataDir/qq-device.json"
        }
    },
    "routes": {
        "prefixes": [
            "/qq"
        ]
    },
    "credentials": {
        "namespace": "qq",
        "shape": "opaque",
        "secretState": true,
        "deviceState": false,
        "inject": {
            "__qqSessions": {
                "secret": "sessions",
                "object": false
            }
        },
        "responseSecrets": {
            "qqSessions": "sessions"
        },
        "auth": {
            "anyOf": [
                {
                    "cookie": "qqmusic_session"
                }
            ],
            "expiredCodes": [
                401
            ]
        },
        "legacy": {
            "cookies": {
                "qqmusic_session": "qqmusic_session"
            },
            "secrets": {
                "__qqSessions": "sessions"
            }
        }
    },
    "upstream": [],
    "display": {
        "name": "QQ 音乐",
        "label": "QQ MUSIC",
        "detail": "全类搜索 · 每日推荐 · 个人音乐 · 歌单编辑",
        "sessionLabel": "QQ SESSION",
        "archiveIdPrefix": "QQ MID / ",
        "order": 2,
        "default": false
    },
    "capabilities": {
        "search": true,
        "suggest": true,
        "resolveLink": false,
        "detail": true,
        "playback": true,
        "preview": true,
        "lyrics": true,
        "account": true,
        "login": true,
        "vip": true,
        "discover": true,
        "categories": true,
        "userPlaylists": true,
        "likedSongs": true,
        "likedAlbums": true,
        "mv": false,
        "officialPlayback": true,
        "alternativeSource": false,
        "mutations": {
            "likeSong": true,
            "subscribeAlbum": true,
            "subscribePlaylist": true,
            "updatePlaylistTracks": true
        },
        "playlistManagement": {
            "createPlaylist": true,
            "renamePlaylist": true,
            "deletePlaylist": true
        }
    },
    "library": {
        "columns": [
            "搜索结果",
            "喜欢的歌曲",
            "我的歌单",
            "收藏歌单",
            "收藏专辑"
        ],
        "sourceOrder": [
            1,
            2,
            3,
            4,
            0
        ],
        "lanes": 5,
        "identityProviders": [
            "netease"
        ],
        "likedModel": "likedSongs",
        "playlistNameMaxLength": 20,
        "playlistEditableRule": "owned-with-dir-range",
        "dirIdRange": [
            1,
            199
        ]
    },
    "quality": {
        "default": "exhigh",
        "options": [
            {
                "id": "best",
                "label": "自动最高可用",
                "tier": "auto",
                "featured": true
