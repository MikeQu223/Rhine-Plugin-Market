            {
                "id": "standard",
                "label": "标准",
                "tier": "standard"
            },
            {
                "id": "exhigh",
                "label": "HQ 高品质",
                "tier": "hq"
            },
            {
                "id": "lossless",
                "label": "SQ 无损 / FLAC",
                "tier": "lossless"
            },
            {
                "id": "ape",
                "label": "SQ 无损 / APE",
                "tier": "lossless"
            }
        ],
        "aliases": {
            "best": "auto"
        },
        "descriptions": {
            "best": {
                "title": "自动最高可用",
                "caption": "BEST AVAILABLE",
                "detail": "由平台选择当前可用的最高音质",
                "badge": ""
            },
            "standard": {
                "title": "标准",
                "caption": "STANDARD",
                "detail": "日常聆听，兼顾音质与数据流量",
                "badge": ""
            },
            "exhigh": {
                "title": "极高",
                "caption": "HIGH QUALITY",
                "detail": "更充分保留有损编码中的声音细节",
                "badge": "hq"
            },
            "lossless": {
                "title": "无损",
                "caption": "LOSSLESS / SQ",
                "detail": "无损编码，保留更完整的录音细节",
                "badge": "sq"
            },
            "ape": {
                "title": "无损 / APE",
                "caption": "LOSSLESS / APE",
                "detail": "以 APE 格式提供无损音源",
                "badge": "sq"
            }
        },
        "featured": [
            "best",
            "lossless"
        ],
        "extras": [],
        "labels": {
            "standard": "标准",
            "hq": "高品质 / HQ",
            "sq": "无损 / SQ",
            "hires": "高解析无损 / Hi-Res",
            "jymaster": "超清母带",
            "jyeffect": "高清臻音",
            "sky": "沉浸环绕声"
        },
        "badges": {
            "sq": "assets/quality/sq.png",
            "hq": "assets/quality/hq.png"
        }
