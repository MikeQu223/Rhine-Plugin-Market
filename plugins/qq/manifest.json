    "login": {
        "required": false,
        "methods": [
            {
                "id": "qr",
                "type": "qr",
                "label": "手机 QQ 扫码",
                "channel": "qq"
            },
            {
                "id": "wechat",
                "type": "qr",
                "label": "微信扫码",
                "channel": "wechat"
            }
        ],
        "pollIntervalMs": 1000,
        "pollTimeoutMs": 300000,
        "failureMessages": {
            "auth.device-limit": "登录设备数量已达上限，请在 QQ 音乐设备管理中删除无用设备",
            "auth.rate-limited": "QQ 登录操作过于频繁，请等待冷却后重试",
            "qr-timeout": "二维码已过期，请重新生成",
            "user-canceled": "已取消扫码登录"
        }
    },
    "discover": {
        "enabled": true,
        "defaultTab": "playlists",
