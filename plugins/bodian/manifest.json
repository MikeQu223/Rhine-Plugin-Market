            "songs": 86400,
            "detail": 21600,
            "trackPage": 21600,
            "artistAlbums": 21600,
            "userPlaylists": 60,
            "likedIDs": 60,
            "likedSongs": 60,
            "likedAlbums": 60,
            "account": 1800,
            "discover": 900,
            "categories": 900,
            "search": 900,
            "suggest": 900
